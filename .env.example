DATABASE_URL="postgresql://USER:PASSWORD@INTERNAL_HOST:5432/DATABASE"
DATABASE_PUBLIC_URL="postgresql://USER:PASSWORD@PUBLIC_HOST:PORT/DATABASE"
RAILWAY_DB_TUNNEL_PORT="15432"
NEXT_PUBLIC_SITE_URL="https://shop.innozanzi.co.za"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_SOCIAL_IMAGE_VERSION="20260806"
MAILTRAP_API_TOKEN="replace-with-mailtrap-api-token"
# Development only. Production always ignores Sandbox and uses live SMTP/API delivery.
MAILTRAP_SANDBOX="false"
MAILTRAP_SANDBOX_INBOX_ID="4808141"
# Production defaults to the Email Sending API. Set "smtp" only when using a
# dedicated live SMTP credential; never use Sandbox credentials in production.
MAILTRAP_DELIVERY_MODE="api"
MAILTRAP_SMTP_HOST="live.smtp.mailtrap.io"
MAILTRAP_SMTP_PORT="587"
MAILTRAP_SMTP_USERNAME="api"
MAILTRAP_SMTP_PASSWORD="replace-with-mailtrap-smtp-password"
MAILTRAP_CONNECTION_TIMEOUT_MS="8000"
MAILTRAP_GREETING_TIMEOUT_MS="8000"
MAILTRAP_SOCKET_TIMEOUT_MS="12000"
MAIL_FROM_EMAIL="support@innozanzi.co.za"
MAIL_FROM_NAME="Innozanzi Shop"
MARKETING_FROM_EMAIL="marketing@innozanzi.co.za"
MARKETING_FROM_NAME="Innozanzi Marketing"
# White wordmark used on the navy background in every email template.
EMAIL_DARK_HEADER_LOGO_URL="https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/uploads/brand/email-logo-white.png"
SUPPORT_EMAIL="support@innozanzi.co.za"
# Digits only, including country code. 071 238 4185 becomes 27712384185.
NEXT_PUBLIC_WHATSAPP_NUMBER="27712384185"
EMAIL_UNSUBSCRIBE_SECRET="replace-with-a-long-random-secret"
CRON_SECRET="replace-with-a-long-random-secret"
SUPABASE_PRIVATE_BUCKET="private-documents"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_YOUR_SECRET_KEY"
SUPABASE_STORAGE_BUCKET="uploads"
OPENAI_API_KEY="sk-proj_YOUR_OPENAI_API_KEY"
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_SHOPPING_MODEL="gpt-5.6-luna"
OPENAI_SOCIAL_MODEL="gpt-5.6-luna"
OPENAI_MARKET_RESEARCH_MODEL="gpt-5.6-terra"
OPENAI_ROUTE_SECRET="replace-with-a-long-random-secret"
AI_MAX_MESSAGE_LENGTH="300"
# Used only for application-side spend estimates in the AI admin dashboard.
AI_INPUT_COST_PER_MILLION="0.25"
AI_OUTPUT_COST_PER_MILLION="2.00"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-at-least-12-characters"
ADMIN_NAME="Shop Administrator"
# Keep credentials in deployment secrets. Never expose feed URLs to the browser.
SYNTECH_FULL_FEED_URL="https://www.syntech.co.za/feeds/feedhandler.php?key=YOUR_KEY&feed=syntech-json-full"
SYNTECH_UPDATE_FEED_URL="https://www.syntech.co.za/feeds/feedhandler.php?key=YOUR_KEY&feed=syntech-json-update"
SYNTECH_SUPPLIER_ID="86000000-0000-4000-8000-000000000001"
# Live deployment: URL of the second, isolated deployment.
TEST_MODE_URL="https://test.shop.innozanzi.co.za"
# Set the following only on that isolated deployment. Its DATABASE_URL must be
# different from LIVE_DATABASE_URL or cleanup is blocked.
TEST_MODE_ENVIRONMENT="false"
TEST_MODE_DELETION_GUARD=""
LIVE_DATABASE_URL=""

# n8n LinkedIn publishing. Use the same long random secret in the n8n HTTP
# credential. LinkedIn OAuth credentials must remain inside n8n.
N8N_BASE_URL="https://YOUR_N8N_HOST"
N8N_LINKEDIN_WEBHOOK_SECRET="replace-with-a-long-random-secret"
N8N_SOCIAL_WEBHOOK_SECRET="replace-with-a-long-random-secret"
N8N_LINKEDIN_APPROVAL_EMAIL="marketing@innozanzi.co.za"
N8N_LINKEDIN_ORGANIZATION_URN="urn:li:organization:YOUR_ORGANIZATION_ID"

# Security: set only to a header your edge proxy ALWAYS overwrites.
# Unset uses a shared conservative bucket; never trust arbitrary forwarded headers.
TRUSTED_CLIENT_IP_HEADER=""
PRODUCT_REQUEST_EMAIL="support@innozanzi.co.za"

# Google Ads base tag (purchase conversion labels are configured separately).
NEXT_PUBLIC_GOOGLE_ADS_ID="AW-18425004357"
# Server-only key: enable Places API (New) in Google Cloud with billing.
# Replace the empty value here locally and in Railway deployment variables.
GOOGLE_MAPS_API_KEY=""


# Approved gateways. Keep disabled until merchant credentials and sandbox callbacks pass.
OZOW_ENABLED="false"
OZOW_SITE_CODE=""
OZOW_PRIVATE_KEY=""
OZOW_API_KEY=""
OZOW_TEST_MODE="true"
# Browser push for Mobile Admin. Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@innozanzi.co.za"
PAYFAST_ENABLED="false"
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX="true"
# Pinnacle XML catalogue. Store the private feed URL only in environment secrets.
PINNACLE_XML_FEED_URL=""
PINNACLE_FEED_USERNAME=""
PINNACLE_FEED_PASSWORD=""
