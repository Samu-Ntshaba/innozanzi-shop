{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK" },
  "deploy": {
    "startCommand": "node -e \"fetch(process.env.NEXT_PUBLIC_SITE_URL + '/api/cron/pc-project-reminders',{method:'POST',headers:{Authorization:'Bearer ' + process.env.CRON_SECRET}}).then(async r=>{console.log(await r.text());if(!r.ok)process.exit(1)})\"",
    "cronSchedule": "0 7 * * *",
    "restartPolicyType": "NEVER"
  }
}
